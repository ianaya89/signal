{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signal",
  "version": "0.1.0",
  "identifier": "app.signal.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "signal",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
